<?xml version="1.0"?>
<package format="2">
  <name>modul09_kinematika</name>
  <version>1.0.0</version>
  <description>
    Modul 09 - ROS Kinematika dan Kontroler
    Praktikum Mekatronika dan Robotika
    Program Studi Teknologi Rekayasa Otomasi
  </description>

